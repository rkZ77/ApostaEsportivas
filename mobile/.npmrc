# O expo-router traz um react-dom (via Radix) que pede react ^19.2.8, enquanto
# o Expo SDK 57 fixa react 19.2.3. O conflito vive inteiro no caminho WEB do
# router, que este app nao usa -- o alvo e' Android e iOS. Sem esta linha,
# `npm install` falha com ERESOLVE em maquina limpa.
legacy-peer-deps=true
