# ─── Ambiente ────────────────────────────────────────────────────────────────
APP_ENV="production"

# ─── Autenticação JWT ────────────────────────────────────────────────────────
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET="GERE_UMA_CHAVE_ALEATORIA_DE_64_CARACTERES"

# ─── Anthropic (IA) ──────────────────────────────────────────────────────────
# Obtenha em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-api03-..."
CHAT_AGENT_MODEL="claude-haiku-4-5-20251001"
AI_MODEL_NAME="claude-sonnet-4-6"

# ─── MercadoPago ────────────────────────────────────────────────────────────
# Obtenha em: https://www.mercadopago.com.br/developers/panel
MERCADOPAGO_ACCESS_TOKEN="APP_USR-..."
MERCADOPAGO_WEBHOOK_SECRET="SEU_WEBHOOK_SECRET"
MERCADOPAGO_SANDBOX="false"

# ─── Banco de Dados (Supabase) ───────────────────────────────────────────────
# Railway injeta DATABASE_URL automaticamente quando você linkar o serviço de DB.
# Para desenvolvimento local, use as variáveis abaixo:
# Obtenha em: https://supabase.com/dashboard/project/SEU_PROJETO/settings/database
DATABASE_URL="postgresql://postgres:SENHA@db.XXXX.supabase.co:5432/postgres"
# Ou individualmente (usado como fallback se DATABASE_URL não estiver definida):
DB_HOST="db.XXXX.supabase.co"
DB_PORT="5432"
DB_NAME="postgres"
DB_USER="postgres"
DB_PASS="SUA_SENHA_DO_BANCO"
DB_SSLMODE="require"

# ─── Gestão de Banca ────────────────────────────────────────────────────────
BANKROLL="1000"
DAILY_CAP_PCT="0.10"
STOP_LOSS_PCT="0.05"

# ─── URLs do Site ────────────────────────────────────────────────────────────
FRONTEND_URL="https://pickia.com.br"
BACKEND_URL="https://pickia.com.br"
SITE_URL="https://pickia.com.br"
ALLOWED_ORIGINS="https://pickia.com.br"

# ─── API Football ────────────────────────────────────────────────────────────
# Obtenha em: https://www.api-football.com/dashboard
API_FOOTBALL_KEY="SUA_CHAVE_API_FOOTBALL"

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
# Para Gmail: use uma "Senha de App" em myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="seu-email@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
SMTP_FROM="Pick IA <seu-email@gmail.com>"
