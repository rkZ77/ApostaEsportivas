# Secrets — nunca commitar
.env
.env.*
!.env.example

# Dados privados
.claude/
scripts/
logs/

# ...menos o build do frontend: `scripts/` acima casa com QUALQUER pasta de
# qualquer nivel, entao engolia website/frontend/scripts/ tambem. O Dockerfile
# roda `npm run build:comprimir` dela; sem isto o deploy quebra com
# MODULE_NOT_FOUND, porque o arquivo existe so' na maquina local.
!website/frontend/scripts/

# ...e menos o gravador de video, que caiu na mesma armadilha. O codigo entra;
# o que ele GERA (narracao, cartoes, webm cru e mp4 final) fica de fora, porque
# e' saida regeravel e pesa dezenas de MB por rodada.
!website/scripts/
website/scripts/video/voz/
website/scripts/video/cartoes/
website/scripts/video/saida/
website/scripts/video/pronto/
website/scripts/video/carrossel/
website/scripts/video/templates/
# sessao.json e' credencial: cookie de sessao logada em producao.
website/scripts/video/sessao.json

# ...e menos as ferramentas do motor, terceira vitima da mesma armadilha
# (2026-09-04). `ApostaEsportivas/src/scripts/` sao 18 arquivos de codigo --
# backfill, backtest e medicao -- e o BACKEND IMPORTA UM DELES EM RUNTIME:
# routers/admin.py faz `from scripts.backfill_cartao_vermelho import _ALVO` nos
# dois endpoints de /dados/vermelho-legado. Como a pasta nunca foi versionada,
# ela nao existe na imagem: em producao os dois botoes so' sabem responder
# "Script de backfill indisponivel", e o teste que cobre a regra so' passava na
# maquina de quem tinha o arquivo solto.
#
# Nao ha' segredo neles: os 16 que falam com banco ou API leem tudo de
# variavel de ambiente.
!ApostaEsportivas/src/scripts/

# Venv do ApostaEsportivas
ApostaEsportivas/venv/
*.key
*.pem
*.p12
*.pfx
*.keystore
*.jks
KEYSTORE_PASSWORD*.txt

# App Android (TWA) — build local, nao versionar
website/android-twa/app/
website/android-twa/*.aab
website/android-twa/*.apk
website/android-twa/local.properties
website/android-twa/.gradle/
website/android-twa/build/

# Python
__pycache__/
.pytest_cache/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/

# Node / Frontend
node_modules/
dist/
# Indice do blog para o llms.txt · gerado no prebuild a partir dos *.meta.ts
website/frontend/public/blog-index.json
.nuxt/
.output/
*.local

# Logs
*.log
logs/

